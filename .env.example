# ── APIs de modelos de IA ──────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Prototipo Sprint 1/2 — gratis en console.groq.com
GROQ_API_KEY=

# ── APIs científicas ───────────────────────────────────────────────
# Opcional: aumenta rate limit de 3 a 10 req/seg
PUBMED_API_KEY=
# Opcional: la API de Orphanet responde sin credencial (medido el 2026-09-15,
# 10 de 10 llamadas). Si se define, se manda en el header apiKey; si no, el
# cliente manda un valor por defecto que el servicio acepta. El Agente 05
# consulta Orphanet igual, esté o no definida.
ORPHANET_API_KEY=

# ── Servidor ───────────────────────────────────────────────────────
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
SESSION_TTL_MINUTES=60

# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
