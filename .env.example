# ── APIs de modelos de IA ──────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── APIs científicas ───────────────────────────────────────────────
PUBMED_API_KEY=         # Opcional: aumenta rate limit de 3 a 10 req/seg
ORPHANET_API_KEY=       # Requiere registro gratuito en orphanet.org

# ── Servidor ───────────────────────────────────────────────────────
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
SESSION_TTL_MINUTES=60

# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
