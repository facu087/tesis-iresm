# ── APIs de modelos de IA ──────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Prototipo Sprint 1/2 — gratis en console.groq.com
GROQ_API_KEY=

# ── APIs científicas ───────────────────────────────────────────────
# Opcional: aumenta rate limit de 3 a 10 req/seg
PUBMED_API_KEY=
# Opcional: la API de Orphanet responde sin credencial (medido el 2026-09-15,
# 10 de 10 llamadas). Si se define, se manda en el header apiKey; si no, el
# cliente manda un valor por defecto que el servicio acepta. El Agente 05
# consulta Orphanet igual, esté o no definida.
ORPHANET_API_KEY=

# ── Servidor ───────────────────────────────────────────────────────
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
SESSION_TTL_MINUTES=60

# ── Control de costos (Sprint 4) ─────────────────────────────────────
# Modo mock del pipeline: respuestas grabadas en vez de llamar al proveedor
# del LLM, para iterar en desarrollo sin gastar cuota. Apagado por defecto;
# activar con 1/true. Nunca se activa solo porque falte GROQ_API_KEY: sin
# clave y sin este modo, el análisis falla con un error claro.
NEXUS_MOCK_LLM=

# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# ── Persistencia de cuentas (Sprint 4 — registro de médicos) ────────
# Ruta del archivo SQLite con cuentas, sesiones y auditoría. Gitignoreada
# como chroma_db/: se regenera con create_all() al levantar el backend.
NEXUS_DB_PATH=./data/nexus.db
# Enlace del buscador de matrícula de la jurisdicción provincial que se
# muestra al admin en la revisión de cuentas pendientes. Puede quedar sin
# definir (el de Córdoba está roto al momento de este cambio, ver
# .claude/CLAUDE.md). El Buscador Nacional REFEPS no es configurable.
PROVINCIAL_LICENSE_SEARCH_URL=
